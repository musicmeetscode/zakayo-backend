# Copy to .env and fill in. Generate a key with: python generate_key.py
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_NAME="Zakayo Industries"
TIME_ZONE=Africa/Kampala

# DATABASE: sqlite (default), postgres or mysql
DB_CHOICE=sqlite
# Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# MySQL / MariaDB:
# DB_NAME=zakayo
# DB_USER=zakayo
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# AUTH
REQUIRE_EMAIL_VERIFICATION=0
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
AUTH_THROTTLE_RATE=20/min

# SOCIAL AUTH (optional)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# EMAIL (defaults to printing emails in the console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# SHOP
# Public URLs used in email links and the email logo.
SITE_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
# EMAIL_LOGO_URL=https://api.example.com/static/shop/email-logo.png
# Who receives "new order / quote / message" alerts (comma-separated).
SALES_NOTIFICATION_EMAILS=snaggayi@human.ug
# Where customer replies go (comma-separated). Empty = DEFAULT_FROM_EMAIL.
SHOP_REPLY_TO=
# Send emails from the Celery worker (1, default) or during the request (0, e.g. no worker running).
# If Redis is unreachable, emails are sent during the request automatically.
EMAIL_IN_BACKGROUND=1
# Rate limit for anonymous website forms (checkout, quotes, contact, newsletter).
PUBLIC_FORM_THROTTLE_RATE=10/min
# Admin path. Use something non-obvious in production, e.g. zi-console/
ADMIN_URL=admin/

# CELERY
CELERY_BROKER_URL=redis://localhost:6379/0

# ADMIN USER (used by: python manage.py create_super_user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePasswordHere
